{
  "log": {
    "loglevel": "warning",
    "access": "/var/log/xray/access.log",
    "error":  "/var/log/xray/error.log"
  },

  "api": {
    "tag":      "api",
    "services": ["HandlerService", "StatsService", "LoggerService"]
  },

  "stats": {},

  "policy": {
    "levels": {
      "0": {
        "statsUserUplink":   true,
        "statsUserDownlink": true,
        "connIdle":          600
      }
    },
    "system": {
      "statsInboundUplink":   true,
      "statsInboundDownlink": true
    }
  },

  "_comment_topology": [
    "All inbounds bind to 127.0.0.1 — nothing is exposed publicly. The",
    "public :443 socket belongs to nginx's stream router, which peeks the",
    "TLS SNI and forwards: <reality_target> → vless-reality-in (7443),",
    "everything else → nginx http (8443) which terminates TLS and routes",
    "WS / sub / admin by path. So CDN hostnames added later in the",
    "dashboard need no nginx change — they hit the stream default route.",
    "google/gstatic pinned to direct so the generate_204 latency probe",
    "always works (it's mis-categorized under geosite:cn in the geo db)."
  ],

  "inbounds": [
    {
      "tag":      "api-in",
      "listen":   "127.0.0.1",
      "port":     10085,
      "protocol": "dokodemo-door",
      "settings": { "address": "127.0.0.1" }
    },
    {
      "tag":      "vless-ws-in",
      "listen":   "127.0.0.1",
      "port":     10000,
      "protocol": "vless",
      "settings": {
        "clients":    [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "__LX_VLESS_WS_PATH__",
          "headers": {}
        }
      },
      "sniffing": {
        "enabled":      true,
        "destOverride": ["http", "tls"]
      }
    },
    {
      "tag":      "vless-grpc-in",
      "listen":   "127.0.0.1",
      "port":     10001,
      "protocol": "vless",
      "settings": {
        "clients":    [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": {
          "serviceName": "__LX_VLESS_GRPC_SERVICE__"
        }
      },
      "sniffing": {
        "enabled":      true,
        "destOverride": ["http", "tls"]
      }
    },
    {
      "tag":      "vless-reality-in",
      "listen":   "127.0.0.1",
      "port":     7443,
      "protocol": "vless",
      "settings": {
        "clients":    [],
        "decryption": "none"
      },
      "streamSettings": {
        "network":  "tcp",
        "security": "reality",
        "realitySettings": {
          "show":         false,
          "dest":         "__LX_REALITY_TARGET__:443",
          "xver":         0,
          "serverNames":  ["__LX_REALITY_TARGET__"],
          "privateKey":   "__LX_REALITY_PRIVKEY__",
          "shortIds":     ["", "__LX_REALITY_SHORT_ID__"]
        },
        "sockopt": {
          "tcpKeepAliveIdle":     30,
          "tcpKeepAliveInterval": 15
        }
      },
      "sniffing": {
        "enabled":      true,
        "destOverride": ["http", "tls"]
      }
    }
  ],

  "outbounds": [
    { "tag": "direct",  "protocol": "freedom",     "settings": {} },
    { "tag": "blocked", "protocol": "blackhole",   "settings": {} }
  ],

  "routing": {
    "rules": [
      { "type": "field", "inboundTag": ["api-in"], "outboundTag": "api" },
      { "type": "field", "outboundTag": "direct",
        "domain": ["geosite:google", "domain:gstatic.com", "domain:gvt1.com", "domain:gvt2.com"] },
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "blocked" }
    ]
  }
}
