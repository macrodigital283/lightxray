[Unit]
Description=lightxray panel daemon
After=network-online.target postgresql.service xray.service
Wants=network-online.target xray.service

[Service]
Type=simple
User=lightxray
Group=lightxray
EnvironmentFile=/etc/lightxray/config.env
ExecStart=/usr/local/bin/lightxrayd
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
# CPU priority — the panel/reconciler deliberately YIELDS to the data plane
# (xray + nginx run CPUWeight=400) so a 60s reconciler tick never jitters a
# live connection under CPU contention. Only matters under saturation; no
# effect when the box has spare CPU.
CPUWeight=40

# Hardening — relaxed from the maximal set because the Domains page shells
# out to `sudo lightxray-applydomain` (issue LE cert + reload nginx +
# restart self) and the Paths page to `sudo lightxray-applypaths` (rotate the
# client/WS path → regenerate nginx + xray config). NoNewPrivileges MUST stay
# false so sudo can escalate. ProtectSystem=full (not strict) keeps /usr +
# /etc read-only EXCEPT the ReadWritePaths below:
#   /etc/lightxray      — config.env + the TLS cert symlinks the helpers write
#   /etc/letsencrypt    — certbot's lineage (Domains page)
#   /etc/nginx          — applypaths regenerates the http backend conf here
#   /usr/local/etc/xray — applypaths regenerates xray's config.json here
# certbot's work/log dirs (/var/lib + /var/log/letsencrypt) live under /var,
# which stays writable under =full. Everything else is locked down.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/log/lightxray /etc/lightxray /etc/letsencrypt /etc/nginx /usr/local/etc/xray

[Install]
WantedBy=multi-user.target
