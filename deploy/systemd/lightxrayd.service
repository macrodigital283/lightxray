[Unit]
Description=lightxray panel daemon
After=network-online.target postgresql.service xray.service
Wants=network-online.target xray.service

[Service]
Type=simple
User=lightxray
Group=lightxray
EnvironmentFile=/etc/lightxray/config.env
ExecStart=/usr/local/bin/lightxrayd
Restart=on-failure
RestartSec=3
LimitNOFILE=65536

# Hardening — relaxed from the maximal set because the Domains page needs
# to shell out to `sudo lightxray-applydomain` (issue LE cert + reload
# nginx + restart self). NoNewPrivileges MUST stay false for sudo to
# escalate; ProtectSystem is full (not strict) so the apply helper's
# writes under /etc/lightxray + /etc/letsencrypt + /etc/nginx work via
# sudo. Everything else stays locked down.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/log/lightxray /etc/lightxray

[Install]
WantedBy=multi-user.target
