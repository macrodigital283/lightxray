[Unit]
Description=xray-core (VLESS+WS+TLS data plane for lightxray)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xray
Group=xray
# Stats gRPC must be loopback-only — see config.
ExecStart=/usr/local/bin/xray run -c /etc/xray/config.json
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
# CPU priority (cgroup v2 weight; default 100). The data plane (xray + nginx)
# outranks the panel, so a reconciler tick or dashboard load can never preempt
# live customer traffic under CPU contention. No effect when CPU is idle — it
# only kicks in under saturation. Pairs with lightxrayd's low CPUWeight.
CPUWeight=400
# NB: the XTLS installer ALSO drops
# /etc/systemd/system/xray.service.d/10-donot_touch_single_conf.conf
# which OVERRIDES the ExecStart above to point at
# /usr/local/etc/xray/config.json. We write our config to that exact path
# in install.sh, so the drop-in just works. If you remove the drop-in
# manually, the ExecStart here points at /etc/xray/config.json — keep that
# in mind when reading logs.
#
# xray needs CAP_NET_BIND_SERVICE if you ever bind it directly to :443.
# In our setup nginx fronts it, so xray binds to 127.0.0.1:10000 and
# this is unnecessary; keep commented for the alternate topology.
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/xray

[Install]
WantedBy=multi-user.target
