# nginx vhost — TLS terminator + path router in front of lightxrayd + xray.
#
# Placeholders the install.sh script substitutes:
#   __LX_DOMAIN__               public FQDN
#   __LX_ADMIN_PROXY_PATH__     admin URL component
#   __LX_CLIENT_PROXY_PATH__    client URL component
#   __LX_VLESS_WS_PATH__        WS path xray listens on
#
# Path-strip behaviour:
#   /<admin>/api/v2/admin/...   →  proxy_pass to lightxrayd, path becomes /api/v2/admin/...
#   /<client>/<uuid>/sub/       →  proxy_pass to lightxrayd, path becomes /<uuid>/sub/
#   /<client>/<uuid><ws-path>   →  proxy_pass to xray (WebSocket upgrade)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __LX_DOMAIN__;

    # ACME challenges land here — install.sh symlinks /var/www/letsencrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __LX_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__LX_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__LX_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    add_header Strict-Transport-Security "max-age=15552000" always;

    # --- admin: strip /<admin>/ prefix so lightxrayd sees /api/v2/admin/... ---
    location /__LX_ADMIN_PROXY_PATH__/api/v2/admin/ {
        proxy_pass http://127.0.0.1:8080/api/v2/admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # --- admin dashboard (server-rendered HTML) ---
    location /__LX_ADMIN_PROXY_PATH__/ui/ {
        proxy_pass http://127.0.0.1:8080/ui/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- client sub: rewrite /<client>/<uuid>/<format>/  →  /<format>/<uuid> ---
    # Each format goes to a different lightxrayd handler:
    #   sub / sub64 / auto  →  base64 VLESS bundle (V2Ray family)
    #   clashmeta           →  Clash Meta YAML (Clash family)
    # The literal format goes first in the rewritten URL so the Go mux's
    # static prefix wins (no overlap with /ui/* etc). Regex is
    # double-quoted because nginx treats bare `{` as a block opener.
    location ~ "^/__LX_CLIENT_PROXY_PATH__/([a-f0-9-]{36})/(sub|sub64|auto|clashmeta)/?$" {
        rewrite ^/__LX_CLIENT_PROXY_PATH__/([a-f0-9-]+)/(sub|sub64|auto|clashmeta)/?$ /$2/$1 break;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # --- xray VLESS+gRPC data plane: client connects to /<grpc-service>/Tun ---
    # gRPC requires HTTP/2 and a different `grpc_pass` directive instead of
    # `proxy_pass`. Service-name path is fixed (xray expects /<serviceName>/Tun
    # or /TunMulti); we keep it loosely matched so any method-name suffix works.
    location ~ "^/__LX_VLESS_GRPC_SERVICE__/" {
        grpc_pass grpc://127.0.0.1:10001;
        grpc_set_header Host $host;
        grpc_read_timeout 86400s;
        grpc_send_timeout 86400s;
    }

    # --- xray VLESS+WS data plane: client connects to /<client>/<uuid><ws-path> ---
    # The vless:// link embeds that full path in its `path` query param so
    # each user's WS URL is unique and includes the secret client_proxy
    # token. Before forwarding to xray we REWRITE the URI back to the
    # bare <ws-path>; xray's WS inbound is configured for that exact
    # path, so any prefix would 404 inside xray.
    location ~ "^/__LX_CLIENT_PROXY_PATH__/[a-f0-9-]{36}__LX_VLESS_WS_PATH__$" {
        rewrite ^.+$ __LX_VLESS_WS_PATH__ break;
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # --- catch-all returns a generic page (anti-fingerprinting) ---
    location / {
        return 444;
    }
}
