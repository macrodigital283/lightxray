# nginx vhost — TLS terminator + path router for lightxrayd + xray.
#
# Placeholders the install.sh script substitutes:
#   __LX_DOMAIN__             public FQDN
#   __LX_ADMIN_PROXY_PATH__   admin URL prefix
#   __LX_CLIENT_PROXY_PATH__  client URL prefix (sub fetch only)
#   __LX_VLESS_WS_PATH__      WS path xray listens on — Hiddify-style
#                             single short random token (e.g. /aiuURgiB…).
#                             Path appears VERBATIM in customer vless URLs;
#                             nginx matches it exact and proxies to xray.
#   __LX_VLESS_GRPC_SERVICE__ gRPC service name xray's reality-grpc inbound listens on
#
# Why shared-WS-path (single short token, all users) over per-user paths:
# The TLS payload is opaque to the carrier, but TLS *record sizes* leak
# the underlying request-line length. Multi-segment per-user paths
# produce visibly larger first encrypted records than Hiddify's single
# short token — some mobile DPI engines (Myanmar carriers in particular)
# appear to key on that side-channel. Matching Hiddify's shape removes
# that signal.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __LX_DOMAIN__;

    # ACME challenges land here — install.sh symlinks /var/www/letsencrypt.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __LX_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__LX_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__LX_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    add_header Strict-Transport-Security "max-age=15552000" always;

    # --- admin: strip /<admin>/ prefix so lightxrayd sees /api/v2/admin/... ---
    location /__LX_ADMIN_PROXY_PATH__/api/v2/admin/ {
        proxy_pass http://127.0.0.1:8080/api/v2/admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # --- admin dashboard (server-rendered HTML) ---
    location /__LX_ADMIN_PROXY_PATH__/ui/ {
        proxy_pass http://127.0.0.1:8080/ui/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- customer sub fetch: rewrite /<client>/<uuid>/<format>/ → /<format>/<uuid> ---
    # Each format goes to a different lightxrayd handler. Regex is
    # double-quoted because nginx treats bare `{` as a block opener.
    location ~ "^/__LX_CLIENT_PROXY_PATH__/([a-f0-9-]{36})/(sub|sub64|auto|clashmeta)/?$" {
        rewrite ^/__LX_CLIENT_PROXY_PATH__/([a-f0-9-]+)/(sub|sub64|auto|clashmeta)/?$ /$2/$1 break;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # --- xray VLESS+gRPC data plane: client connects to /<grpc-service>/Tun ---
    location ~ "^/__LX_VLESS_GRPC_SERVICE__/" {
        grpc_pass grpc://127.0.0.1:10001;
        grpc_set_header Host $host;
        grpc_read_timeout 86400s;
        grpc_send_timeout 86400s;
    }

    # --- xray VLESS+WS data plane: Hiddify-style short shared path ---
    # `location =` is an EXACT-MATCH form — handler runs only when the
    # request URI matches __LX_VLESS_WS_PATH__ verbatim, no rewriting,
    # no regex backtracking. xray's wsSettings.path is configured to
    # the same literal so the request lines up end-to-end.
    location = __LX_VLESS_WS_PATH__ {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # --- catch-all returns a generic page (anti-fingerprinting) ---
    location / {
        return 444;
    }
}
