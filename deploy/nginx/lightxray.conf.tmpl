# nginx HTTP backend — sits on 127.0.0.1:8443 BEHIND the stream SNI router
# (see stream-sni-router.conf.tmpl). The stream router on the public :443
# forwards every non-Reality SNI here. This block terminates TLS and routes
# by PATH, so it is a single catch-all `server_name _` — any management or
# CDN-fronted hostname lands here and the path matching does the rest.
# That is why adding a CDN host later (dashboard only) needs no nginx edit.
#
# Placeholders install.sh substitutes:
#   __LX_DOMAIN__             management FQDN (LE cert subject)
#   __LX_ADMIN_PROXY_PATH__   admin URL prefix
#   __LX_CLIENT_PROXY_PATH__  client URL prefix (sub fetch only)
#   __LX_VLESS_WS_PATH__      Hiddify-style single short WS token (exact-match)
#   __LX_VLESS_GRPC_SERVICE__ gRPC service name

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Port 80 — ACME challenge + redirect. Default-server so any Host works.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

# Internal HTTPS backend — only reachable from the stream router on loopback.
server {
    # In-listen 'http2' flag (deprecated but still accepted in nginx >=
    # 1.25.1) instead of the standalone 'http2 on;' directive (which only
    # exists on 1.25.1+) so this works on Ubuntu 24.04's nginx 1.24 too.
    listen 127.0.0.1:8443 ssl http2 default_server;
    server_name _;

    # Fixed cert path — the Domains page / install.sh symlink the active
    # cert here, so nginx config never changes when the management domain
    # is set or changed (just the symlink target + a reload).
    ssl_certificate     /etc/lightxray/tls/current/fullchain.pem;
    ssl_certificate_key /etc/lightxray/tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # TLS session resumption — lets a returning peer skip the full handshake's
    # asymmetric crypto (the CPU-expensive ECDSA/RSA + ECDHE), so reconnect
    # storms stop spiking CPU. On CDN-fronted WS the resuming peer is the
    # Cloudflare edge on the CF→origin leg (each WS is its own connection — CF
    # can't pool them); direct clients resume too. nginx already issues tickets
    # by default, but only with a 5-minute window and no cache: a 50 MB shared
    # cache + 1-day timeout ALSO resumes the long-idle reconnects (device
    # sleep/wake, backgrounded apps) that otherwise pay a full handshake.
    # Purely a server-side TLS optimization — invisible to the VLESS key, the
    # pool, and client configs; applied by a graceful `nginx -s reload`.
    ssl_session_cache   shared:SSL:50m;
    ssl_session_timeout 1d;
    ssl_session_tickets on;
    add_header Strict-Transport-Security "max-age=15552000" always;

    # admin JSON API
    location /__LX_ADMIN_PROXY_PATH__/api/v2/admin/ {
        proxy_pass http://127.0.0.1:8080/api/v2/admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    # admin dashboard
    location /__LX_ADMIN_PROXY_PATH__/ui/ {
        proxy_pass http://127.0.0.1:8080/ui/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Hiddify-style one-click admin login: /<admin_path>/<admin_uuid> mints a
    # dashboard session and redirects. The admin UUID in the path IS the
    # credential (same secret as the login form). Rewritten to /ui/enter/<uuid>.
    location ~ "^/__LX_ADMIN_PROXY_PATH__/([a-f0-9-]{36})/?$" {
        rewrite ^/__LX_ADMIN_PROXY_PATH__/([a-f0-9-]+)/?$ /ui/enter/$1 break;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # customer sub fetch (auto/sub/sub64/clashmeta) — rewrite to /<fmt>/<uuid>
    location ~ "^/__LX_CLIENT_PROXY_PATH__/([a-f0-9-]{36})/(sub|sub64|auto|clashmeta)/?$" {
        rewrite ^/__LX_CLIENT_PROXY_PATH__/([a-f0-9-]+)/(sub|sub64|auto|clashmeta)/?$ /$2/$1 break;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # gRPC data plane
    location ~ "^/__LX_VLESS_GRPC_SERVICE__/" {
        grpc_pass grpc://127.0.0.1:10001;
        grpc_set_header Host $host;
        grpc_read_timeout 86400s;
        grpc_send_timeout 86400s;
    }

    # WS data plane — Hiddify-style single short token, exact match.
    location = __LX_VLESS_WS_PATH__ {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # everything else — generic close (anti-fingerprinting)
    location / { return 444; }
}
