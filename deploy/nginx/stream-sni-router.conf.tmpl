# nginx stream-mode SNI router — owns the public :443 socket. Peeks the
# TLS SNI (ssl_preread, no termination) and forwards the raw connection
# to the right backend:
#
#   SNI = <reality_target>   → xray Reality (127.0.0.1:7443)
#   anything else (default)  → nginx http backend (127.0.0.1:8443)
#
# The single explicit rule is the Reality target; EVERYTHING else falls
# to the default http backend. That's the whole trick behind "add CDN
# domains later with zero nginx changes" — a new CDN hostname's SNI just
# hits `default` → nginx http → path-based WS routing.
#
# Included from /etc/nginx/nginx.conf via a top-level
#   stream { include /etc/nginx/stream-conf.d/*.conf; }
#
# Placeholder install.sh substitutes:
#   __LX_REALITY_TARGET__   the borrowed-site SNI (e.g. www.google.com)

map $ssl_preread_server_name $sni_backend {
    __LX_REALITY_TARGET__  reality_backend;
    default                http_backend;
}

upstream http_backend    { server 127.0.0.1:8443; }
upstream reality_backend { server 127.0.0.1:7443; }

server {
    listen     443 reuseport;
    listen [::]:443 reuseport;
    ssl_preread on;
    proxy_connect_timeout 5s;
    proxy_timeout 86400s;
    proxy_pass $sni_backend;
}
