#!/usr/bin/env bash
# Privileged helper invoked by lightxrayd via sudo from the dashboard's
# Transports page. Three positional 0/1 args: enable WS, gRPC, XHTTP.
#
# It rewrites LX_XRAY_INBOUND_TAG in config.env — the set of xray inbound
# tags that AddUser/RemoveUser fan out across (internal/xray/client.go) AND
# that the subscription builder reads to decide which transport URLs to
# emit. Then it restarts xray + lightxrayd out-of-band so a disabled
# transport's inbound loses all its users (goes dark) while the others keep
# serving.
#
# vless-reality-in is preserved untouched — Reality is managed from its own
# dashboard page, not here.
#
# Restart order matters: xray first (its in-memory user list is wiped,
# dropping users from the now-disabled inbound), then lightxrayd
# re-hydrates users onto only the enabled inbound tags.
set -euo pipefail

WS="${1:-}"; GRPC="${2:-}"; XHTTP="${3:-}"
for v in "$WS" "$GRPC" "$XHTTP"; do
    [[ "$v" == "0" || "$v" == "1" ]] || { echo "ERROR: usage: lightxray-applytransports <0|1> <0|1> <0|1>"; exit 1; }
done
if [[ "$WS" == "0" && "$GRPC" == "0" && "$XHTTP" == "0" ]]; then
    echo "ERROR: refusing to disable all transports (data plane would go dark)"; exit 1
fi

CONF=/etc/lightxray/config.env
[[ -f "$CONF" ]] || { echo "ERROR: $CONF missing"; exit 1; }
set -a; . "$CONF"; set +a
OLD="${LX_XRAY_INBOUND_TAG:-}"

# Rebuild the tag CSV from the flags, in a stable order, preserving Reality
# membership if it was present.
NEW=""
[[ "$WS"    == "1" ]] && NEW="${NEW:+$NEW,}vless-ws-in"
[[ "$GRPC"  == "1" ]] && NEW="${NEW:+$NEW,}vless-grpc-in"
[[ "$XHTTP" == "1" ]] && NEW="${NEW:+$NEW,}vless-xhttp-in"
case ",$OLD," in
    *,vless-reality-in,*) NEW="${NEW:+$NEW,}vless-reality-in" ;;
esac

[[ -n "$NEW" ]] || { echo "ERROR: computed empty tag set — aborting"; exit 1; }

echo "==> LX_XRAY_INBOUND_TAG: ${OLD} -> ${NEW}"
if [[ "$NEW" == "$OLD" ]]; then
    echo "OK: no change — transports already match."; exit 0
fi

if grep -q '^LX_XRAY_INBOUND_TAG=' "$CONF"; then
    sed -i "s|^LX_XRAY_INBOUND_TAG=.*|LX_XRAY_INBOUND_TAG=${NEW}|" "$CONF"
else
    echo "LX_XRAY_INBOUND_TAG=${NEW}" >> "$CONF"
fi

# Restart OUT-OF-BAND: this helper is a sudo child of lightxrayd.service, so a
# direct restart would SIGTERM our own cgroup mid-command and the dashboard
# would see a false failure. Schedule it ~2s out in its own transient unit so
# our success message + the HTTP response flush first. (Same pattern as
# lightxray-applypaths.)
systemd-run --on-active=2s --timer-property=AccuracySec=200ms --collect \
    /bin/sh -c "/usr/bin/systemctl restart xray && /usr/bin/systemctl restart lightxrayd" >/dev/null

echo "OK: transports updated (ws=${WS} grpc=${GRPC} xhttp=${XHTTP})."
echo "    xray + lightxrayd restart in ~2s; disabled transports drop their users and leave subscriptions."
